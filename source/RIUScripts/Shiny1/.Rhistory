bearing <- toRadians(bearing) # (in radians)
earthRadius <- 6371e3 # (in metres)
angularDist <- distance/earthRadius
endPt <- rep(0,2)
startPt <- toRadians(startPt)
endPt[1] <- asin(sin(startPt[1])*cos(angularDist) + cos(startPt[1])*sin(angularDist)*cos(bearing))
endPt[2] <- startPt[2] + atan2(sin(bearing)*sin(angularDist)*cos(startPt[1]),
cos(angularDist)-sin(startPt[1])*sin(endPt[1]))
endPt <- toDegrees(endPt)
return(endPt)
}
bearings <- seq(from=360, to=90, by=-90)-90 # West-South-Esat-North for bbox in osmdata::opq
endPts <- sapply(bearings, function(bearing) {
out <- destPt(startPt = center, distance = distance, bearing = bearing)
if(bearing%%180 == 0) {
return(out[1])
} else {
return(out[2])
}
})
return(endPts)
}
# Search by bounding box (minimum longitude, minimum latitude,
#                         maximum longitude, maximum latitude
#                         (or West-South-Esat-North)),
# see examples
# Different from the API
# see https://wiki.openstreetmap.org/wiki/Overpass_API#The_map_query
q0<-opq(bbox=searchBounds(c(22.28676, 114.13389))) # Mei Sun Lau
# add features
# see https://wiki.openstreetmap.org/wiki/Map_Features
q1 <- add_osm_feature(q0, key = "shop", value = "supermarket")
# q1 <- add_osm_feature(q1, key = "building", value = "!this", value_exact = FALSE)
# q1 <- add_osm_feature(q1, key = "shop", value = "!this", value_exact = FALSE)
doc <- osmdata_xml(q1, tempfile(fileext = ".xml")) # download the osm data
x <- osmdata_sf(q1, doc) # transform the osm xml to sf format
View(x)
q1 <- add_osm_feature(q0, key = "shop")
# q1 <- add_osm_feature(q1, key = "building", value = "!this", value_exact = FALSE)
# q1 <- add_osm_feature(q1, key = "shop", value = "!this", value_exact = FALSE)
doc <- osmdata_xml(q1, tempfile(fileext = ".xml")) # download the osm data
x <- osmdata_sf(q1, doc) # transform the osm xml to sf format
View(x)
x[["osm_points"]][["name"]]
x[["osm_points"]][["shop"]]
View(x)
citation()
toBibtex(citation())
