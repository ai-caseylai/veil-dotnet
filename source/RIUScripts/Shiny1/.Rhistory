library(GGally)
library(data.table)
library(ggplot2)
loess_with_cor <- function(data, mapping, ..., method = "pearson") {
x <- eval(mapping$x, data)
y <- eval(mapping$y, data)
cor <- cor(x, y, method = method)
ggally_smooth_loess(data, mapping, ...) +
ggplot2::geom_label(
data = data.frame(
x = min(x, na.rm = TRUE),
y = max(y, na.rm = TRUE),
lab = round(cor, digits = 3)
),
mapping = ggplot2::aes(x = x, y = y, label = lab, alpha = 0),
hjust = 0, vjust = 1,
size = 5, fontface = "bold",
inherit.aes = FALSE # do not inherit anything from the ...
)
}
sevenFans_weather_weekly <- readRDS("./RDS/sevenFans_weather_weekly.rds")
ggduo(sevenFans_weather_weekly, c("Temperature", "Relative humidity",
"Amount of cloud", "Rainfall", "Sunshine"),
"Sales", types = list(continuous = loess_with_cor))
